# =============================================================================
# LangChain Claude Code learning repository - environment template
#
# Copy this file to .env, then replace the placeholders:
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Never commit .env or put a real API key in source code.
# The implemented chapters use langchain-openai/ChatOpenAI and therefore need
# an OpenAI-compatible endpoint. Provider availability, model IDs and prices
# can change; verify them in the provider's current documentation.
# =============================================================================


# =============================================================================
# 1. Required by the current chapter code
# =============================================================================

# API key (required)
#
# All chapters read the standard OPENAI_API_KEY variable.
# Put the key for the selected OpenAI-compatible provider here.
OPENAI_API_KEY=your-api-key

# Model ID (required)
MODEL_ID=your-model-id

# OpenAI-compatible base URL (required by s10; recommended for every chapter)
# Keep the provider's /v1 or /compatible-mode/v1 suffix when shown below.
BASE_URL=https://your-openai-compatible-endpoint/v1


# =============================================================================
# 2. Compatibility aliases
# =============================================================================

# s06 also accepts OPENAI_BASE_URL as an alias for BASE_URL. The other
# implemented chapters still require BASE_URL above.
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1


# =============================================================================
# 3. OpenAI-compatible providers used by the current LangChain code
#
# Uncomment one preset's BASE_URL and MODEL_ID, and put that provider's API key
# in OPENAI_API_KEY above. Later duplicate keys override the generic values
# near the top when parsed by python-dotenv.
# =============================================================================

# ---- Global / international endpoints --------------------------------------

# OpenAI             https://platform.openai.com
# BASE_URL=https://api.openai.com/v1
# MODEL_ID=gpt-4o-mini

# DeepSeek           https://platform.deepseek.com
# BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=deepseek-chat
# MODEL_ID=deepseek-reasoner
# MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash

# MiniMax            https://www.minimax.io
# BASE_URL=https://api.minimax.io/v1
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM / Z.ai         https://z.ai
# BASE_URL=https://api.z.ai/api/paas/v4
# MODEL_ID=glm-5.2

# Kimi / Moonshot    https://platform.kimi.ai
# BASE_URL=https://api.moonshot.ai/v1
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# Google Gemini (OpenAI compatibility layer)
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_ID=gemini-2.5-flash

# SiliconFlow international
# BASE_URL=https://api.siliconflow.com/v1
# MODEL_ID=deepseek-ai/DeepSeek-V3

# OpenRouter
# BASE_URL=https://openrouter.ai/api/v1
# MODEL_ID=anthropic/claude-sonnet-4


# ---- China mainland endpoints ---------------------------------------------

# MiniMax            https://platform.minimaxi.com
# BASE_URL=https://api.minimaxi.com/v1
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM / Zhipu        https://open.bigmodel.cn
# BASE_URL=https://open.bigmodel.cn/api/paas/v4
# MODEL_ID=glm-5.2

# Kimi / Moonshot    https://platform.moonshot.cn
# BASE_URL=https://api.moonshot.cn/v1
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# Alibaba DashScope / Qwen
# BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_ID=qwen-plus

# SiliconFlow China
# BASE_URL=https://api.siliconflow.cn/v1
# MODEL_ID=deepseek-ai/DeepSeek-V3

# DeepSeek has no regional split; use the global endpoint shown above.


# =============================================================================
# 4. Local OpenAI-compatible servers
#
# Local servers usually accept any non-empty placeholder API key. Confirm the
# model name with the local server before starting a chapter.
# =============================================================================

# Ollama             https://ollama.com
# OPENAI_API_KEY=ollama
# BASE_URL=http://127.0.0.1:11434/v1
# MODEL_ID=qwen3:8b

# LM Studio
# OPENAI_API_KEY=lm-studio
# BASE_URL=http://127.0.0.1:1234/v1
# MODEL_ID=your-loaded-model-id

# vLLM
# OPENAI_API_KEY=vllm
# BASE_URL=http://127.0.0.1:8000/v1
# MODEL_ID=your-served-model-id


# =============================================================================
# 5. Anthropic providers — FOR A FUTURE ChatAnthropic ADAPTER ONLY（当前代码不生效）
#
# ⚠️ 仅供未来切换到 langchain_anthropic.ChatAnthropic 时参考，当前章节代码完全不读取本节的变量。
# IMPORTANT: these settings do NOT affect the current chapter code because it
# instantiates langchain_openai.ChatOpenAI. They are kept here for parity with
# shareAI-lab/learn-claude-code and for a future ChatAnthropic adapter.
#
# To use them, install langchain-anthropic, replace ChatOpenAI with
# langchain_anthropic.ChatAnthropic, and read ANTHROPIC_API_KEY plus
# ANTHROPIC_BASE_URL. MODEL_ID can remain the shared model variable.
# =============================================================================

# Anthropic official
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL_ID=claude-sonnet-4-6

# ---- International Anthropic-compatible endpoints -------------------------

# MiniMax            https://www.minimax.io
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM / Z.ai         https://z.ai
# ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# MODEL_ID=glm-5.2

# Kimi / Moonshot    https://platform.kimi.ai
# ANTHROPIC_BASE_URL=https://api.moonshot.ai/anthropic
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# DeepSeek           https://platform.deepseek.com
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-pro
# MODEL_ID=deepseek-v4-flash


# ---- China mainland Anthropic-compatible endpoints ------------------------

# MiniMax            https://platform.minimaxi.com
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# MODEL_ID=MiniMax-M3
# MODEL_ID=MiniMax-M2.7
# MODEL_ID=MiniMax-M2.7-highspeed

# GLM / Zhipu        https://open.bigmodel.cn
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# MODEL_ID=glm-5.2

# Kimi / Moonshot    https://platform.moonshot.cn
# ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
# MODEL_ID=kimi-k2.7-code
# MODEL_ID=kimi-k2.7-code-highspeed
# MODEL_ID=kimi-k2.6

# DeepSeek has no regional split; use the global endpoint shown above.


# =============================================================================
# 6. Chapter-specific optional settings
# =============================================================================

# s11_error_recovery (currently half-finished)
# Use another model available at the same BASE_URL. Leave empty to disable the
# fallback client. If the fallback belongs to another provider, s11 will need
# separate fallback key/base-URL support before that combination can work.
FALLBACK_MODEL_ID=your-fallback-model-id

# s08_context_compact
# Set the real context window of MODEL_ID. s08 subtracts its output allowance
# and safety buffer from this number to decide when proactive compaction runs.
CONTEXT_WINDOW_TOKENS=128000


# =============================================================================
# 7. LangSmith tracing (optional)
#
# Traces may contain prompts, tool inputs, tool outputs and model responses.
# Keep tracing disabled unless you intentionally want to upload that data.
# New LANGSMITH_* names are preferred; LANGCHAIN_* aliases are retained for
# compatibility with older LangChain/LangSmith versions.
# =============================================================================

# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=learn-cc-langchain4j
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Legacy aliases
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=learn-cc-langchain4j
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# =============================================================================
# 8. Network and proxy settings (optional)
# =============================================================================

# Standard proxy variables honored by common Python HTTP clients.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Custom CA certificates for corporate/self-hosted HTTPS environments.
# SSL_CERT_FILE=C:/path/to/ca-bundle.pem
# REQUESTS_CA_BUNDLE=C:/path/to/ca-bundle.pem
